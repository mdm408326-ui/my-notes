VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Web Push (reminder notifications). Generate a key pair with:
#   npx web-push generate-vapid-keys
# Put the PUBLIC key here. The PRIVATE key is set as a Supabase function secret,
# never in this file — see supabase/README-reminders.md.
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
